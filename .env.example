# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shoppro?retryWrites=true&w=majority
MONGODB_DB=shoppro

# JWT Secret Key for API Authentication (Change to a strong random secret in production)
JWT_SECRET=shoppro-secret-key-change-this-in-production-2026

# Server Port (optional, defaults to 3000)
PORT=3000
